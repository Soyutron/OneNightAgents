# コピーして .env を作る(.env は .gitignore 済み)
#   cp .env.example .env
# 読み込み方: uv run --env-file .env python ...  または コード側で dotenv

# LangSmith(docs/architecture.md 10.1)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=onenightagents
# 組織が US 以外のリージョンなら必須。未設定だと鍵が認証されない
#   GCP US:   https://api.smith.langchain.com(既定。設定不要)
#   GCP APAC: https://apac.api.smith.langchain.com
#   GCP EU:   https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
# 鍵が複数ワークスペースに紐づく場合のみ
# LANGSMITH_WORKSPACE_ID=

# Ollama(既定のままなら不要)
# OLLAMA_HOST=http://localhost:11434
